local function createESPForPlayer(p, char, head)
    if not head then return end
    local d = espData[p]
    if d then
        if d.character == char and d.bb and d.bb.Parent then return end
        removeESPForPlayer(p)
    end

    local hl = Instance.new("Highlight")
    hl.Name = "TSB_HL"
    hl.Adornee = char
    hl.FillTransparency = 0.7
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = Settings.C2
    hl.OutlineColor = Settings.C2
    hl.Parent = char

    local bb = Instance.new("BillboardGui")
    bb.Name = "TSB_BB"
    bb.Adornee = head
    bb.Size = UDim2.new(0, 120, 0, 44)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 150
    bb.LightInfluence = 0
    bb.Parent = head

    local nameLbl = Instance.new("TextLabel", bb)
    nameLbl.Size = UDim2.new(1, 0, 0, 22)
    nameLbl.Position = UDim2.new(0, 0, 0, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = p.Name
    nameLbl.TextColor3 = Settings.C2
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 14
    nameLbl.Parent = bb

    local hpLbl = Instance.new("TextLabel", bb)
    hpLbl.Size = UDim2.new(1, 0, 0, 18)
    hpLbl.Position = UDim2.new(0, 0, 0, 22)
    hpLbl.BackgroundTransparency = 1
    hpLbl.TextColor3 = Color3.fromRGB(100, 220, 150)
    hpLbl.Font = Enum.Font.GothamBold
    hpLbl.TextSize = 13
    hpLbl.Text = "100 / 100"
    hpLbl.Parent = bb

    espData[p] = { bb = bb, hl = hl, character = char, nameLbl = nameLbl, hpLbl = hpLbl }
end

task.spawn(function()
