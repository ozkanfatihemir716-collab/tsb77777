local function getHealthColor(hum)
    local ratio = hum.Health / math.max(1, hum.MaxHealth)
    if ratio > 0.6 then return Color3.fromRGB(100, 220, 150)
    elseif ratio > 0.3 then return Color3.fromRGB(255, 200, 80)
    else return Color3.fromRGB(255, 90, 90) end
end

local function ApplyAutoSettings()
    if not Settings.AutoAdjust then
        Settings._BoostWalk = 1.0; Settings._BoostJump = 1.0; Settings._BoostHitbox = 1.0
        return
    end
    if IS_MOBILE then
        Settings._BoostWalk = 1.15; Settings._BoostJump = 1.10; Settings._BoostHitbox = 1.15
    else
        if fps < 30 then
            Settings._BoostWalk = 1.10; Settings._BoostJump = 1.05; Settings._BoostHitbox = 1.15
        else
            Settings._BoostWalk = 1.25; Settings._BoostJump = 1.20; Settings._BoostHitbox = 1.35
        end
    end
end

local function removeESPForPlayer(p)
    local d = espData[p]
    if d then
        if d.bb then d.bb:Destroy() end
        if d.hl then d.hl:Destroy() end
        espData[p] = nil
    end
end

local function cleanAllESP()
    for p, _ in pairs(espData) do removeESPForPlayer(p) end
    espData = {}
end

local function updateHitboxSize()
    if currentHitbox and currentHitbox.Parent then
        currentHitbox.Size = Vector3.new(5, 10, 2) * (Settings.HitboxSize * Settings._BoostHitbox)
    end
end

local function removeHitbox()
    if currentHitbox then
        currentHitbox:Destroy()
        currentHitbox = nil
    end
end

local function createHitbox()
    if currentHitbox then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hb = Instance.new("Part")
    hb.Name = "TSB_Hitbox"
    hb.Size = Vector3.new(5, 10, 2) * (Settings.HitboxSize * Settings._BoostHitbox)
    hb.CFrame = hrp.CFrame
    hb.Transparency = 1
    hb.CanCollide = false
    hb.CanTouch = true
    hb.Massless = true
    hb.Anchored = false
    hb.Parent = char
    local w = Instance.new("WeldConstraint")
    w.Part0 = hrp
    w.Part1 = hrp
    w.Part1 = hb
    w.Parent = hrp
    currentHitbox = hb
end

