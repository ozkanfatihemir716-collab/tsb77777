        currentVal = v
        valLbl.Text = tostring(math.floor(v * 10) / 10) .. sfx
        lbl.Text = label .. ": " .. (math.floor(v * 10) / 10) .. sfx
        callback(v)
    end
    dn.Activated:Connect(function() setV(math.max(minV, currentVal - step)) end)
    up.Activated:Connect(function() setV(math.min(maxV, currentVal + step)) end)
end

